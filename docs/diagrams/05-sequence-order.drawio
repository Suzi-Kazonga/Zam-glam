        <mxCell id="note-price" value="Prices are read from the database both times, never taken
from the request — so a tampered basket changes nothing, and
the customer is charged exactly what the quote showed." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbeb;strokeColor=#b45309;align=left;spacingLeft=6;fontSize=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="980" y="260" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note-tx" value="All of it in one transaction. A failure half way cannot leave
