        <mxCell id="diagramSubtitle" value="Registration, vetting, and everything an administrator can do afterwards. Shops and couriers are vetted differently; suspension and deletion apply to all three." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
