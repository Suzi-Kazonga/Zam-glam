PORT=5000
NODE_ENV=development
JWT_SECRET=zamglam_super_secret_key
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_PASSWORD=
DB_NAME=zamglam_db

# Third-party courier credentials. Leave unset: no such integration is implemented,
# and the platform falls back to its own couriers.
# YANGO_API_URL=
# YANGO_API_KEY=

# Optional courier service exposing POST /api/courier/quote (the bundled
# courier-service/ Flask app speaks this).
# COURIER_SERVICE_URL=http://localhost:5001

# Delivery pricing
# DELIVERY_BASE_PRICE=20
# DELIVERY_PRICE_PER_KM=5

# Unclaimed parcels are auto-assigned to an on-duty courier after this many minutes
# PICKUP_ESCALATION_MINUTES=60
